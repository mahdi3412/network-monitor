# کپی این فایل به dashboard/.env.local و مقدارها را تنظیم کنید.
# (deploy/install-server.ps1 خودش PORT را در .env.local تنظیم می‌کند.)

# --- سرور ---
PORT=3000

# --- heartbeat و تاریخچه (برای ۱۰۰۰ کلاینت) ---
# فاصله heartbeat همه ایجنت‌ها (ثانیه، ۱۰ تا ۶۰۰)
HEARTBEAT_INTERVAL_SECONDS=60
# بدون تغییر IP/نام/کاربر، هر چند دقیقه یک ردیف تاریخچه ذخیره شود
HEARTBEAT_HISTORY_MINUTES=60
# مدت نگهداری تاریخچه (روز)
HEARTBEAT_RETENTION_DAYS=7

# --- اسکن شبکه (سمت سرور) ---
# فاصله اسکن (ثانیه، حداقل ۶۰). اسکن هر میزبان زنده چند فرآیند اجرا می‌کند؛ برای شبکه بزرگ ۹۰۰ یا بیشتر مناسب است.
NETWORK_SCAN_INTERVAL_SECONDS=900
# محدوده‌های اضافه برای اسکن (CIDR، با کاما یا فاصله). محدوده‌های خود سرور خودکار تشخیص داده می‌شود.
NETWORK_MONITOR_RANGES=
# اگر تجهیزات شما SNMP دارند (اختیاری)
NETWORK_SNMP_COMMUNITY=

# --- Active Directory (سرور باید ویندوز باشد) ---
AD_ENABLED=false
# مثال: ldap://dc1.example.local  (چند مقدار با کاما)
AD_URLS=
# مثال: DC=example,DC=local
AD_BASE_DN=
# attribute شماره پرسنلی
AD_PERSONNEL_ATTRIBUTE=employeeID
# integrated (با حساب اجراکننده سرویس) یا credentials
AD_AUTH_MODE=integrated
AD_BIND_USER=
AD_BIND_PASSWORD=
# همگام‌سازی خودکار کاربران (دقیقه) و کامپیوترها
AD_SYNC_INTERVAL_MINUTES=60
AD_SYNC_COMPUTERS=false

# --- بکاپ (node dashboard/scripts/backup.mjs) ---
# BACKUP_DIR=D:\Backups\NetworkMonitor
BACKUP_KEEP=14
