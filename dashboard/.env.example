# Comma, space, semicolon, or newline separated CIDR ranges managed by the server.
# Example:
# NETWORK_MONITOR_RANGES=10.10.10.0/24,10.10.20.0/24,10.10.30.0/24
NETWORK_MONITOR_RANGES=

# Server-side network discovery interval (seconds).
NETWORK_SCAN_INTERVAL_SECONDS=300

# Active Directory integration.
# Keep the password out of source control. Put it in the server environment only.
AD_ENABLED=false
# Prefer LDAPS, for example: ldaps://dc01.example.local:636
AD_URL=
AD_BASE_DN=DC=example,DC=local
# Personnel/employee identifier attribute used by your AD user objects.
# Common choice: employeeID. Change this if your directory uses another attribute.
AD_PERSONNEL_ATTRIBUTE=employeeID
AD_BIND_USER=
AD_BIND_PASSWORD=
