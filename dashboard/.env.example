# Comma, space, semicolon, or newline separated CIDR ranges managed by the server.
# Example:
# NETWORK_MONITOR_RANGES=10.10.10.0/24,10.10.20.0/24,10.10.30.0/24
NETWORK_MONITOR_RANGES=

# Server-side network discovery interval (seconds).
NETWORK_SCAN_INTERVAL_SECONDS=300

# Active Directory integration.
# Keep credentials out of source control. Put them in the server environment only.
AD_ENABLED=false
# One or more AD endpoints, separated by commas/semicolons/spaces.
# Integrated authentication uses Negotiate (Kerberos/NTLM); LDAP/389 is recommended.
AD_URLS=ldap://dc01.example.local:389,ldap://dc02.example.local:389
AD_URL=
AD_BASE_DN=DC=example,DC=local
# Personnel/employee identifier attribute used by your AD user objects.
# Common choice: employeeID. Change this if your directory uses another attribute.
AD_PERSONNEL_ATTRIBUTE=sAMAccountName

# Authentication:
# integrated = use the Windows account running the Next.js server.
# credentials = use AD_BIND_USER + AD_BIND_PASSWORD.
AD_AUTH_MODE=integrated
AD_BIND_USER=
AD_BIND_PASSWORD=
